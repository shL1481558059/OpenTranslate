{
  "name": "snap-translate-mac",
  "productName": "OpenTranslate",
  "version": "0.1.0",
  "private": true,
  "description": "Screenshot translate desktop app (Tauri) with a local DeepL-compatible translation API",
  "scripts": {
    "start:api": "node api/server.js",
    "start:desktop": "node scripts/run-tauri.js dev",
    "dist": "node scripts/run-tauri.js build",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}

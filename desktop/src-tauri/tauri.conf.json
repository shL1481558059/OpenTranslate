{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTranslate",
  "version": "0.1.1",
  "identifier": "com.opentranslate.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node ../scripts/dev-ui-server.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenTranslate",
        "url": "translate.html",
        "width": 900,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "swift/": "swift/"
    }
  }
}

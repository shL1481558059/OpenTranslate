{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTranslate",
  "version": "0.1.6",
  "identifier": "com.opentranslate.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node ../scripts/dev-ui-server.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenTranslate",
        "url": "translate.html",
        "width": 1200,
        "height": 780,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/96x96.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "swift/": "swift/"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/opentranslate.svg": "icons/opentranslate.svg",
          "/usr/share/icons/hicolor/48x48@2/apps/opentranslate.png": "icons/96x96.png",
          "/usr/share/icons/hicolor/64x64@2/apps/opentranslate.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128@2/apps/opentranslate.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/256x256@2/apps/opentranslate.png": "icons/512x512.png",
          "/usr/share/applications/opentranslate.desktop": "opentranslate.desktop"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/opentranslate.svg": "icons/opentranslate.svg",
          "/usr/share/icons/hicolor/48x48@2/apps/opentranslate.png": "icons/96x96.png",
          "/usr/share/icons/hicolor/64x64@2/apps/opentranslate.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128@2/apps/opentranslate.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/256x256@2/apps/opentranslate.png": "icons/512x512.png",
          "/usr/share/applications/opentranslate.desktop": "opentranslate.desktop"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/scalable/apps/opentranslate.svg": "icons/opentranslate.svg",
          "/usr/share/icons/hicolor/48x48@2/apps/opentranslate.png": "icons/96x96.png",
          "/usr/share/icons/hicolor/64x64@2/apps/opentranslate.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128@2/apps/opentranslate.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/256x256@2/apps/opentranslate.png": "icons/512x512.png",
          "/usr/share/applications/opentranslate.desktop": "opentranslate.desktop"
        }
      }
    }
  }
}
